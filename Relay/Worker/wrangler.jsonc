{
  "name": "warden-agent-relay",
  "main": "worker.mjs",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "FEEDS", "class_name": "FeedRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FeedRelay"] }],
  "observability": { "enabled": false }
}
